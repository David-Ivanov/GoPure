{{ 'component-main-btn.css' |  asset_url | stylesheet_tag }}

{% style %}
    .main-btn-{{ section.id }} {
        margin-bottom: {{ section.settings.btn_margin }}px;
        background-color: {{ section.settings.color_scheme.settings.button }};
        color: {{ section.settings.color_scheme.settings.button_label }};
    }

{% endstyle %}

<a class="main-btn main-btn-{{ section.id }}" href="{{ section.settings.btn_link }}">
    <p class="main-btn-text">{{ section.settings.btn_text }}</p>
    
    {% if section.settings.btn_arrow %}
        {% render 'icon-arrow' %}
    {% endif %}
</a>