{{ 'section-secondary-benefits.css' |  asset_url |  stylesheet_tag }}

{% style %}
  .secondary-benefits {
     margin-bottom: {{ section.settings.margin }}px;
     background-color: {{ section.settings.color_scheme.settings.secondary_background }}
  }

  .secondary-benefits-title {
    color: {{ section.settings.color_scheme.settings.accent }};
    margin-bottom: {{ section.settings.title_margin }}px;
  }

  .secondary-benefits-box {
     margin-bottom: {{ section.settings.box_margin }}px;
  }

  .secondary-benefits-text {
    color: {{ section.settings.color_scheme.settings.accent }};
  }

  .secondary-benefits-text {
    color: {{ section.settings.color_scheme.settings.accent }};
  }

.main-btn-{{ section.id }} {
    background-color: {{ section.settings.color_scheme.settings.button }};
    color: {{ section.settings.color_scheme.settings.button_label }};
}
{% endstyle %}

<h2 class="title secondary-benefits-title">{{ section.settings.title }}</h2>

<div class="secondary-benefits-box">
      {% for benefit in section.blocks %}
       {% if  benefit.type == 'benefits' %}        

        <div class="secondary-benefits-item-box">
          {% if benefit.settings.img != blank %}
            {{ benefit.settings.img |  image_url: width: 195 |  image_tag  }}
          {% endif %}
          <p class="secondary-benefits-text">{{ benefit.settings.text }}</p>
        </div>

      {% endif %}
    {% endfor %}
</div>


<a class="main-btn main-btn-{{ section.id }}" href="{{ routes.all_products_collection_url }}">
    <p class="main-btn-text">{{ section.settings.btn_text }}</p>
    {% render 'icon-arrow' %}
</a>

{% schema %}
{
    "name": "Secondary benefits",
    "tag": "section",
    "class": "secondary-benefits",
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color scheme",
            "default": "schema-1"
        },
        {
            "type": "range",
            "id": "margin",
            "label": "Margin bottom",
            "max": 100,
            "min": 0,
            "step": 5,
            "default": 0
        },
        {
            "type": "header",
            "content": "Title"
        },
        {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Title"
       }, 
       {
            "type": "range",
            "id": "title_margin",
            "label": "Title margin bottom",
            "max": 100,
            "min": 0,
            "step": 5,
            "default": 0
       },
        {
            "type": "range",
            "id": "box_margin",
            "label": "Box margin bottom",
            "max": 100,
            "min": 0,
            "step": 5,
            "default": 0
       },
        {
            "type": "text",
            "id": "btn_text",
            "label": "Button text",
            "default": "Get Your GOpure"
       }
        ],
    "blocks": [
        {
            "name": "Benefits",
            "type": "benefits",
            "limit": 4,
            "settings": [
                {
                    "type": "image_picker",
                    "id": "img",
                    "label": "Image"
                },
                {
                    "type": "text",
                    "id": "text",
                    "label": "Benefit text",
                    "default": "Text"
                }
        ]
        }
    ],
        "presets": [
            {
                "name": "Secondary benefits"
            }
        ]
        
}
{% endschema %}