{{ 'section-tertiary-benefits.css' |  asset_url |  stylesheet_tag }}

{% style %}
  .tertiary-benefits {
     margin-bottom: {{ section.settings.margin }}px;
  }

  .tertiary-benefits-title {
    color: {{ section.settings.color_scheme.settings.accent }};
    margin-bottom: {{ section.settings.title_margin }}px;
  }

  .tertiary-benefits-text {
    color: {{ section.settings.color_scheme.settings.accent }};
  }

  .tertiary-benefits-text {
    color: {{ section.settings.color_scheme.settings.accent }};
  }

  .main-btn-{{ section.id }} {
    background-color: {{ section.settings.color_scheme.settings.button }};
    color: {{ section.settings.color_scheme.settings.button_label }};
  }
{% endstyle %}

<div class="tertiary-benefits-main-box">
  
<div class="tertiary-benefits-box">
  <h2 class="title tertiary-benefits-title">{{ section.settings.title }}</h2>

  <div class="tertiary-benefits-text-box">
    
    {% for benefit in section.blocks %}
      {% if  benefit.type == 'benefit' %}

            <p class="tertiary-benefits-text">{{ benefit.settings.text }}</p>

      {% endif %}
    {% endfor %}
    
  </div>

  <a class="main-btn main-btn-{{ section.id }}" href="{{ routes.all_products_collection_url }}">
      <p class="main-btn-text">{{ section.settings.btn_text }}</p>
      {% render 'icon-arrow' %}
  </a>
  </div>

  {% if section.settings.img != blank %}
    {{ section.settings.img | image_url: width: 565 | image_tag }}
  {% endif %}
</div>

{% schema %}
  {
    "name": "Tertiary benefits",
    "tag": "section",
    "class": "tertiary-benefits",
    "settings": [
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "schema-1"
      },
      {
        "type": "image_picker",
        "id": "img",
        "label": "Image"
      },
      {
        "type": "range",
        "id": "margin",
        "label": "Margin bottom",
        "max": 100,
        "min": 0,
        "step": 5,
        "default": 0
      },
      {
        "type": "header",
        "content": "Title"
      }, {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Title"
      }, {
        "type": "range",
        "id": "title_margin",
        "label": "Title margin bottom",
        "max": 100,
        "min": 0,
        "step": 5,
        "default": 0
      },
      {
        "type": "text",
        "id": "btn_text",
        "label": "Button text",
        "default": "Get Your GOpure"
      }
      
    ],
    "blocks": [
      {
        "name": "Benefit",
        "type": "benefit",
        "limit": 5,
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Benefit",
            "default": "Text"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Tertiary benefits"
      }
    ]
  }
{% endschema %}