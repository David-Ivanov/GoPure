{% style %}
    .motivetion {
        background-image: url('{{ section.settings.bg |  image_url: width: 1440  }}');
    }
{% endstyle %}

<div class="motivation-box">
    {% render 'icon-trees' %}

    <h2 class="motivation-title">{{ section.settings.title }}</h2>

    <p class="motivation-text">{{ section.settings.text }}</p>

    <a class="motivation-btn main-btn main-btn-{{ section.id }}" href="{{ routes.all_products_collection_url }}">
        <p class="motivation-btn-text main-btn-text">{{ section.settings.btn_text }}</p>
        {% render 'icon-arrow' %}
    </a>
</div>

<p class="motivation-mark">{{ section.settings.mark }}</p>

{% render 'social-icons' %}

{% schema %}
{
    "name": "Motivation",
    "tag": "section",
    "class": "motivation",
    "settings": [
        {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "schema-1"
      },
      {
        "type": "image_picker",
        "id": "bg",
        "label": "Background image"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Title"
      },
      {
        "type": "text",
        "id": "text",
        "label": "Text",
        "default": "Text"
      },
      {
        "type": "text",
        "id": "mark",
        "label": "Mark",
        "default": "@thegopurepod"
      },
      {
        "type": "text",
        "id": "btn_text",
        "label": "Button text",
        "default": "Shop now"
      }
        ],
    "presets": [
        {
            "name": "Motivation"
        }
    ]
}
{% endschema %}