{{ 'section-benefits.css' |  asset_url |  stylesheet_tag }}

{% style %}
    .benefits {
        margin-bottom: {{ section.settings.margin }}px;
    }
    .benefits-title {
        margin-bottom: {{ section.settings.title_margin }}px;
        color: {{ section.settings.color_scheme.settings.accent }};

    }
    .benefits-main-box {
        margin-bottom: {{ section.settings.main_box_margin }}px;
        background-color: {{ section.settings.color_scheme.settings.secondary_accent }};
        background-image: url("{{ 'benefits-bg.png' |  asset_img_url: 'master' }}");
    }

    .benefits-subtitle {
        color: {{ section.settings.color_scheme.settings.secondary_text }};
    }

    .benefits-text {
        color: {{ section.settings.color_scheme.settings.secondary_text }};
    }

    .benefits-btn-{{ section.id }} {
        background-color: {{ section.settings.color_scheme.settings.button }};
        color: {{ section.settings.color_scheme.settings.secondary_text }};
    }
{% endstyle %}

<h2 class="benefits-title">{{ section.settings.title }}</h2>

<div class="benefits-main-box">

    <div class="benefits-box">

            {% for benefit in section.blocks %}
                {% if benefit.type == "benefit" %}

                    <div class="benefits-subbox">
                        {% if benefit.settings.icon != blank %}
                            {{ benefit.settings.icon |  image_url: width: 54 |  image_tag }}
                        {% endif %}
                        
                        <div class="benefits-text-box">
                            <h3 class="benefits-subtitle">{{ benefit.settings.subtitle }}</h3>
                            <p class="benefits-text">{{ benefit.settings.text }}</p>
                        </div>
                    </div>

                {% endif %}
            {% endfor %}

    </div>

</div>

{% for btn in section.blocks %}
    {% if btn.type == "button" %}

        <a class="main-btn benefits-btn benefits-btn-{{ section.id }}" href="{{ routes.all_products_collection_url  }}">
            <p class="main-btn-text benefits-btn-text benefits-btn-text-{{ section.id }}">{{ btn.settings.btn_text }}</p>
        
            {% render 'icon-arrow' %}
        </a>

    {% endif %}      
{% endfor %}


{% schema %}
{
    "name": "benefits",
    "class": "benefits",
    "tag": "section",
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color scheme",
            "default": "schema-1"
        },
        {
            "type": "range",
            "id": "margin",
            "label": "Margin bottom",
            "max": 100,
            "min": 0,
            "step": 5,
            "default": 0
        },
        {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Title"
        },
        {
            "type": "range",
            "id": "title_margin",
            "label": "Title margin bottom",
            "max": 100,
            "min": 0,
            "step": 5,
            "default": 0
        },
        {
            "type": "range",
            "id": "main_box_margin",
            "label": "Main box margin bottom",
            "max": 100,
            "min": 0,
            "step": 5,
            "default": 0
        }
        ],
        "blocks": [
            {
                "name": "benefit",
                "type": "benefit",
                "limit": 4,
                "settings": [
                    {
                        "type": "image_picker",
                        "id": "icon",
                        "label": "Icon"
                    },
                    {
                        "type": "text",
                        "id": "subtitle",
                        "label": "Subtitle",
                        "default": "Subtitle"
                    },
                    {
                        "type": "text",
                        "id": "text",
                        "label": "Text",
                        "default": "Text"
                    }
                ]
            },
            {
                "name": "button",
                "type": "button",
                "limit": 1,
                "settings": [
                    {
                        "type": "text",
                        "id": "btn_text",
                        "label": "Button text",
                        "default": "Purchase Now"
                    }
                ]
            }
        ],
        "presets": [
            {
                "name": "Benefits"
            }
        ]
}
{% endschema %}